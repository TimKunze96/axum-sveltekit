# Copy to .env. Every value has a working local default. The API reads
# these through src/config.rs (one typed Config struct); the compose
# stack passes the same names to its containers.

# The display name; also the prefix of the app's cookies. The frontend
# reads PUBLIC_APP_NAME (Vite loads this same file), keep both equal.
APP_NAME=Starter
PUBLIC_APP_NAME=Starter

# local | production. Local keeps cookies usable over plain http; unset
# means production.
APP_ENV=local

# The public origin the app is served on (the shared dev origin locally,
# https://example.com in production) and, for Caddy, its host.
# APP_URL=http://localhost:8787
# APP_HOST=example.com

# Postgres (the docker-compose instance) and the API listen address.
# DATABASE_URL=postgres://starter:starter@127.0.0.1:5436/starter
# DATABASE_MAX_CONNECTIONS=10
# BIND_ADDR=127.0.0.1:3200
# RUST_LOG=info

# How long a login lasts.
# SESSION_LIFETIME_DAYS=30

# Comma-separated emails whose accounts are site admins (applied on
# registration and on every login).
# ADMIN_EMAILS=

# How long a password reset link works.
# PASSWORD_RESET_LIFETIME_MINUTES=60

# Outbound mail (the password reset link). Without SMTP_HOST every mail
# is written to the API log instead, which is what you want locally.
# MAIL_FROM=Starter <no-reply@localhost>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Compose stack only: the Postgres password (defaults to `starter`).
# POSTGRES_PASSWORD=

# Tests only: the suites create and migrate this database themselves.
# TEST_DATABASE_URL=postgres://starter:starter@127.0.0.1:5436/starter_test
